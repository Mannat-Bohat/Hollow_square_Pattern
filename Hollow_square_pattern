//Hollow Square pattern 
#include <iostream>

int main() {
    int size;

    std::cout << "Enter the side length of the square: ";
    std::cin >> size;

    std::cout << "\n--- Hollow Square Pattern ---\n\n";

    // Outer loop for rows
    for (int i = 1; i <= size; ++i) {
        
        // Inner loop for columns
        for (int j = 1; j <= size; ++j) {
            
            // Condition to check if we are on the border of the square
            if (i == 1 || i == size || j == 1 || j == size) {
                std::cout << "* ";
            } else {
                std::cout << "  "; // Prints empty space inside the square
            }
        }
        
        // Move to the next line after completing each row
        std::cout << std::endl;
    }

    return 0;
}
